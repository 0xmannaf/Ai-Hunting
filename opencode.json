{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true,
      "env": {}
    }
  },
  "instructions": ["AGENTS.md"],
  "agent": {
    "default": {
      "tools": {
        "chrome-devtools_*": true,
        "bash": true,
        "read": true,
        "write": true,
        "edit": true,
        "glob": true,
        "grep": true,
        "webfetch": true,
        "websearch": true
      }
    }
  }
}